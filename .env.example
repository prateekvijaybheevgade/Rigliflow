# ==============================================================================
# FLOWLIFY & OMEGACAD ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Gemini AI API Key (Required for all AI Vision, Sketch-to-CAD, & Prompt generation)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# Vercel Blob Storage Token (Required for cloud storage of sketches, camera snaps & CAD files)
# Auto-injected by Vercel when you add a Blob Store to your project in the Vercel dashboard.
# For local testing, copy the token from Vercel Project Settings -> Storage -> Blob.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Clerk Authentication (Required for user Sign In & Sign Up protection)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Optional App URL
APP_URL="http://localhost:3000"
